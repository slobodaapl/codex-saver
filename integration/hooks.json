{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Projects/personal/codex-saver/target/release/codex-saver\" hook",
            "statusMessage": "Schedule thread compaction",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Projects/personal/codex-saver/target/release/codex-saver\" hook",
            "statusMessage": "Schedule subagent compaction or cleanup",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Projects/personal/codex-saver/target/release/codex-saver\" hook",
            "statusMessage": "Check thread cache and cancel scheduled compaction",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Projects/personal/codex-saver/target/release/codex-saver\" hook",
            "statusMessage": "Cancel scheduled subagent action",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Projects/personal/codex-saver/target/release/codex-saver\" hook",
            "statusMessage": "Cancel scheduled compaction",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
